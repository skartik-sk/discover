// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id            String    @id @default(cuid())
  username      String    @unique // Username for profile URLs
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  walletAddress String?   @unique
  password      String?   // For email/password auth
  bio           String?
  website       String?
  twitter       String?
  github        String?
  trustScore    Int       @default(0)
  
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  reviews       Review[]
  likes         Like[]
  proposals     Proposal[]
  votes         Vote[]
  stakes        Stake[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// NextAuth Account model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth Verification Token
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Project model
model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  tagline     String
  description String
  logoUrl     String
  coverUrl    String
  videoUrl    String?
  websiteUrl  String
  
  // Category and tags
  category    String   // DeFi, NFT, DAO, Gaming, Infrastructure, Social, Other
  tags        String   // Comma-separated tags
  
  // Blockchain
  blockchains String   // Comma-separated blockchain names
  
  // Social links
  twitter     String?
  discord     String?
  github      String?
  telegram    String?
  
  // Metrics
  upvotes     Int      @default(0)
  viewCount   Int      @default(0)
  
  // Status
  status      String   @default("pending") // pending, approved, rejected
  featured    Boolean  @default(false)
  
  // Relationships
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews     Review[]
  likes       Like[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@index([category])
  @@index([status])
}

// Review model
model Review {
  id          String   @id @default(cuid())
  rating      Int      // 1-5 stars
  comment     String
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([projectId, userId]) // One review per user per project
}

// Like model
model Like {
  id          String   @id @default(cuid())
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@unique([projectId, userId]) // One like per user per project
}

// Governance Proposal model
model Proposal {
  id          String   @id @default(cuid())
  title       String
  description String
  status      String   @default("active") // active, passed, rejected, closed
  votesFor    Int      @default(0)
  votesAgainst Int     @default(0)
  
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  
  votes       Vote[]
  
  startsAt    DateTime @default(now())
  endsAt      DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([status])
}

// Vote model
model Vote {
  id          String   @id @default(cuid())
  support     Boolean  // true = for, false = against
  
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@unique([proposalId, userId]) // One vote per user per proposal
}

// Stake model
model Stake {
  id          String   @id @default(cuid())
  amount      Int      // Amount staked
  tier        String   // validator, contributor, observer
  apy         Float    // Annual percentage yield
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
}
